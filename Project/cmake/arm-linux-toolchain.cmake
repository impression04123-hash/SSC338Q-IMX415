set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(FPV_TOOLCHAIN_PREFIX "$ENV{FPV_TOOLCHAIN_PREFIX}" CACHE STRING "Absolute toolchain prefix ending in -")
set(FPV_SYSROOT "$ENV{FPV_SYSROOT}" CACHE PATH "Target SDK sysroot")
if(NOT FPV_TOOLCHAIN_PREFIX OR NOT IS_DIRECTORY "${FPV_SYSROOT}")
  message(FATAL_ERROR "Set FPV_TOOLCHAIN_PREFIX and an existing FPV_SYSROOT for the specific board ABI")
endif()
set(CMAKE_C_COMPILER "${FPV_TOOLCHAIN_PREFIX}gcc")
set(CMAKE_CXX_COMPILER "${FPV_TOOLCHAIN_PREFIX}g++")
set(CMAKE_AR "${FPV_TOOLCHAIN_PREFIX}ar")
set(CMAKE_RANLIB "${FPV_TOOLCHAIN_PREFIX}ranlib")
set(CMAKE_SYSROOT "${FPV_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${FPV_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES FPV_TOOLCHAIN_PREFIX FPV_SYSROOT)
