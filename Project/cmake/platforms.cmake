function(fpv_add_platforms)
  if(FPV_ENABLE_SIGMASTAR AND FPV_ENABLE_HISILICON)
    message(FATAL_ERROR "Air and ground SDK ABIs require separate build directories")
  endif()
  foreach(platform IN ITEMS sigmastar hisilicon)
    string(TOUPPER "${platform}" upper)
    if(FPV_ENABLE_${upper})
      set(sdk "${PROJECT_SOURCE_DIR}/third_party/sdk/${platform}")
      if(platform STREQUAL "sigmastar")
        set(source sigmastar_capture.c)
        set(libs mi_isp mi_sensor mi_sys mi_venc mi_vif mi_vpe cus3a ispalgo cam_os_wrapper)
      else()
        set(source hisilicon_display.c)
        set(libs mpi hdmi jpeg VoiceEngine upvqe dnvqe)
      endif()
      add_library(fpv_${platform} STATIC "${PROJECT_SOURCE_DIR}/src/platform/${source}")
      target_include_directories(fpv_${platform} PRIVATE "${sdk}/include" PUBLIC "${PROJECT_SOURCE_DIR}/include")
      target_compile_features(fpv_${platform} PRIVATE c_std_11)
      target_link_libraries(fpv_${platform} PUBLIC fpv_core m pthread dl)
      foreach(lib IN LISTS libs)
        # Explicit SDK paths prevent resolving an unrelated host library.
        set(path "${sdk}/lib/lib${lib}.so")
        if(NOT EXISTS "${path}")
          message(FATAL_ERROR "Required SDK library missing: ${path}")
        endif()
        target_link_libraries(fpv_${platform} PUBLIC "${path}")
      endforeach()
      target_link_options(fpv_${platform} INTERFACE "LINKER:-rpath-link,${sdk}/lib")
    endif()
  endforeach()
endfunction()
